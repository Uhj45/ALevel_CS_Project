	(text "16 Channel PWM controller and\nPWM Fan, controlled by RPi \nover i2c bus. Spare channels \nto allow the project to be extended"
		(exclude_from_sim no)
		(at 146.304 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "230dc73f-0bd9-4218-a2b9-0cb73a37fdbe")
	)
	(text "Analogue to Digital Converter\ncontrolled by RPi using i2c bus.\nLDR R1 and resistor R3 forms\na potential divider. Voltage \nacross R1 varies with light\nlevel. A2D converter returns\na digital value representing this\nvoltage."
		(exclude_from_sim no)
		(at 277.368 72.39 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "3e3340aa-9174-417a-8f4b-4bcc28bb9417")
	)
